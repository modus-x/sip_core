+/* send a NAT PING rtp packet. sequence number is NOT incremented */
+void
+ff_rtp_send_nat_ping(AVFormatContext* s1, const uint8_t* buf1, int len)
+{
+    RTPMuxContext* s = s1->priv_data;
+
+    av_log(s1, AV_LOG_TRACE, "rtp_send_nat_ping size=%d\n", len);
+
+    /* build the RTP header */
+    avio_w8(s1->pb, RTP_VERSION << 6);
+
+    avio_w8(s1->pb, (0 & 0x7f) | (0 << 7));
+    avio_wb16(s1->pb, 0);
+    avio_wb32(s1->pb, s->timestamp);
+    avio_wb32(s1->pb, s->ssrc);
+
+    avio_write(s1->pb, buf1, len);
+    avio_flush(s1->pb);
+}

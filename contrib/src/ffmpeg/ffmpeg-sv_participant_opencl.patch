+float4 scale_lankzos(__read_only  image2d_t src,
+                     const        int2      src_loc,
+                     const        int2      overlay_size,
+                     __constant   float    *cx,
+                     __constant   float    *cy,
+                     const        int2      flt_size)
+{
+    const sampler_t s_img = (CLK_NORMALIZED_COORDS_FALSE |
+                             CLK_ADDRESS_CLAMP_TO_EDGE |
+                             CLK_FILTER_NEAREST);
+
+    float2 dst_size = convert_float2(overlay_size);
+    float2 src_size = convert_float2(get_image_dim(src));
+
+    float2 src_coord = (convert_float2(src_loc) + 0.5f) * src_size / dst_size;
+    int2 src_pos = convert_int2(floor(src_coord - 0.5f));
+
+    float4 col = 0.0f;
+    for (int i = 0; i < flt_size.y; ++i) {
+        float4 s = 0.0f;
+        for (int j = 0; j < flt_size.x; ++j) {
+            float4 c = read_imagef(src, s_img, src_pos + (int2){flt_size.x/2 - j, flt_size.y/2 - i});
+            s += c * cx[src_loc.x * flt_size.x + j];
+        }
+        col += s * cy[src_loc.y * flt_size.y + i];
+    }
+
+    return col;
+}
+
+__kernel void overlay(__write_only image2d_t dst,
+                      __read_only  image2d_t main,
+                      __read_only  image2d_t overlay,
+                      const int2 overlay_loc,
+                      const int2 overlay_size,
+                      const int border_width,
+                      const float4 border_color,
+                      const int dir,
+                      __constant   float    *cx,
+                      __constant   float    *cy,
+                      const int2      flt_size)
+{
+    const sampler_t sampler = (CLK_NORMALIZED_COORDS_FALSE |
+                               CLK_FILTER_NEAREST | CLK_ADDRESS_NONE);
+
+    int2 global_loc = (int2)(get_global_id(0), get_global_id(1));
+
+    if (global_loc.x < overlay_loc.x + border_width ||
+        global_loc.y < overlay_loc.y + border_width || 
+        global_loc.x >= overlay_loc.x + overlay_size.x + 2 * border_width ||
+        global_loc.y >= overlay_loc.y + overlay_size.y + 2 * border_width) {
+        float4 val = read_imagef(main, sampler, global_loc);
+        write_imagef(dst, global_loc, val);
+    }
+    else if (global_loc.x < overlay_loc.x ||
+             global_loc.y < overlay_loc.y ||
+             global_loc.x >= overlay_loc.x + overlay_size.x ||
+             global_loc.y >= overlay_loc.y + overlay_size.y) {
+        write_imagef(dst, global_loc, border_color);
+    }
+    else {
+        int2 overlay_rel = global_loc - overlay_loc;
+        int xin = (dir & 2) ? (overlay_size.y - 1 - overlay_rel.y) : overlay_rel.y;
+        int yin = (dir & 1) ? (overlay_size.x - 1 - overlay_rel.x) : overlay_rel.x;
+        overlay_rel.x = xin;
+        overlay_rel.y = yin;
+        float4 val = scale_lankzos(overlay, overlay_rel, overlay_size, cx, cy, flt_size);
+        write_imagef(dst, global_loc, val);
+    }
+}
+
+__kernel void overlay_no_transpose(__write_only image2d_t dst,
+                      __read_only  image2d_t main,
+                      __read_only  image2d_t overlay,
+                      const int2 overlay_loc,
+                      const int2 overlay_size,
+                      const int border_width,
+                      const float4 border_color,
+                      __constant   float    *cx,
+                      __constant   float    *cy,
+                      const int2      flt_size)
+{
+    const sampler_t sampler = (CLK_NORMALIZED_COORDS_FALSE |
+                               CLK_FILTER_NEAREST | CLK_ADDRESS_NONE);
+
+    int2 global_loc = (int2)(get_global_id(0), get_global_id(1));
+
+    if (global_loc.x < overlay_loc.x + border_width ||
+        global_loc.y < overlay_loc.y + border_width || 
+        global_loc.x >= overlay_loc.x + overlay_size.x + 2 * border_width ||
+        global_loc.y >= overlay_loc.y + overlay_size.y + 2 * border_width) {
+        float4 val = read_imagef(main, sampler, global_loc);
+        write_imagef(dst, global_loc, val);
+    }
+    else if (global_loc.x < overlay_loc.x ||
+             global_loc.y < overlay_loc.y ||
+             global_loc.x >= overlay_loc.x + overlay_size.x ||
+             global_loc.y >= overlay_loc.y + overlay_size.y) {
+        write_imagef(dst, global_loc, border_color);
+    }
+    else {
+        int2 overlay_rel = global_loc - overlay_loc;
+        float4 val = scale_lankzos(overlay, overlay_rel, overlay_size, cx, cy, flt_size);
+        write_imagef(dst, global_loc, val);
+    }
+}

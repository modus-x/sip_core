+__kernel void overlay_no_mask(__write_only image2d_t dst,
+                      __read_only  image2d_t main,
+                      __read_only  image2d_t overlay,
+                      const int4   overlay_box,
+                      const int2   overlay_offset,
+                      const int2   overlay_target_size,
+                      const int    border_width,
+                      const float4 border_color,
+                      const int    dir,
+                      __constant   float    *cx,
+                      __constant   float    *cy,
+                      const int2   flt_size)
+{
+    const sampler_t sampler = (CLK_NORMALIZED_COORDS_FALSE |
+                               CLK_FILTER_NEAREST | CLK_ADDRESS_NONE);
+
+    int2 global_loc = (int2)(get_global_id(0), get_global_id(1));
+
+    if (global_loc.x < overlay_box.x - border_width ||
+        global_loc.y < overlay_box.y - border_width ||
+        global_loc.x >= overlay_box.x + overlay_box.z + border_width ||
+        global_loc.y >= overlay_box.y + overlay_box.w + border_width)
+    {
+        float4 val = read_imagef(main, sampler, global_loc);
+        write_imagef(dst, global_loc, val);
+    }
+    else if (global_loc.x < overlay_box.x ||
+             global_loc.y < overlay_box.y ||
+             global_loc.x >= overlay_box.x + overlay_box.z ||
+             global_loc.y >= overlay_box.y + overlay_box.w)
+    {
+        write_imagef(dst, global_loc, border_color);
+    }
+    else
+    {
+        int2 overlay_rel = global_loc - (int2)(overlay_box.x, overlay_box.y);
+
+
+        int2 actual_target_size;
+        if (dir & 4) {
+            actual_target_size = overlay_target_size;
+        } else {
+            actual_target_size = overlay_target_size.yx;
+        }
+
+        float4 overlay_val;
+        if (overlay_rel.x < overlay_offset.x ||
+            overlay_rel.y < overlay_offset.y ||
+            overlay_rel.x >= overlay_offset.x + actual_target_size.x ||
+            overlay_rel.y >= overlay_offset.y + actual_target_size.y)
+        {
+            overlay_val = read_imagef(main, sampler, global_loc);
+        }
+        else {
+            overlay_rel = overlay_rel - overlay_offset;
+
+            int xin = (dir & 2) ? (overlay_target_size.y - 1 - overlay_rel.y) : overlay_rel.y;
+            int yin = (dir & 1) ? (overlay_target_size.x - 1 - overlay_rel.x) : overlay_rel.x;
+            if (dir & 4) {
+                overlay_rel.x = yin;
+                overlay_rel.y = xin;
+                overlay_val = scale_lankzos(overlay, overlay_rel - overlay_offset,
+                                            overlay_target_size, cx, cy, flt_size);
+            } else {
+                overlay_rel.x = xin;
+                overlay_rel.y = yin;
+                overlay_val = scale_lankzos(overlay, overlay_rel - overlay_offset,
+                                            overlay_target_size.yx, cx, cy, flt_size);
+            }
+
+            overlay_val = scale_lankzos(overlay, overlay_rel,
+                                        overlay_target_size, cx, cy, flt_size);
+        }
+
+        write_imagef(dst, global_loc, overlay_val);
+    }
+}

+typedef struct SvParticipantOpenCLContext {
+    // OpenCL common
+    OpenCLFilterContext ocf;
+    int              initialised;
+    cl_command_queue command_queue;
+    
+    // overlay params
+    cl_kernel        kernel;
+    FFFrameSync      fs;
+    int              nb_planes;
+    int              x_subsample;
+    int              y_subsample;
+
+    // transpose params
+    int dir;            ///< TransposeDir
+
+    // crop params
+    char *x_expr, *y_expr, *w_expr, *h_expr;
+    double cropped_sar;
+
+    // scale params
+    cl_mem  cx, cy;
+    int     src_w,    src_h;
+    cl_int2 flt_size;
+
+    // draw text params
+// #if CONFIG_LIBFONTCONFIG
+//     uint8_t *font;                  ///< font to be used
+// #endif
+//     char *fontsize_expr;            ///< expression for fontsize
+//     AVExpr *fontsize_pexpr;         ///< parsed expressions for fontsize
+//     uint8_t *fontfile;              ///< font to be used
+//     uint8_t *text;                  ///< text to be drawn
+//     unsigned int fontsize;          ///< font size to use
+//     unsigned int default_fontsize;  ///< default font size to use
+//     FFDrawContext dc;
+//     FFDrawColor fontcolor;          ///< foreground color
+
+    // common params
+    int              x;
+    int              y;
+    int              width;
+    int              height;
+    int              border_w;
+    uint8_t          bordercolor_rgba[4];
+    // Stored as a normalized float for passing to the OpenCL kernel
+    cl_float4        bordercolor_rgba_float;
+} SvParticipantOpenCLContext;
+
+static float sinc(float t)
+{
+    return (t == 0) ? 1.0 : sin(t * M_PI) / (t * M_PI);
+}
+
+static float lanczos(float t, float a)
+{
+    return (t < a) ? sinc(t) * sinc(t / a) : 0;
+}
+
+static int sv_participant_opencl_load(AVFilterContext *avctx,
+                                      enum AVPixelFormat main_format,
+                                      enum AVPixelFormat sv_participant_format)
+{
+    SvParticipantOpenCLContext *ctx = avctx->priv;
+    cl_int cle;
+    const char *kernel;
+    const AVPixFmtDescriptor *main_desc, *overlay_desc;
+    int err, i, j, main_planes, overlay_planes;
+    int filterw, filterh;
+    float scalex, scaley;
+    float *cx = NULL, *cy = NULL;
+    const char *source = ff_source_sv_participant_cl;
+
+    main_desc    = av_pix_fmt_desc_get(main_format);
+    overlay_desc = av_pix_fmt_desc_get(sv_participant_format);
+
+    err = ff_opencl_filter_load_program(avctx, &source, 1);
+    if (err < 0)
+        goto fail;
+
+    ctx->command_queue = clCreateCommandQueue(ctx->ocf.hwctx->context,
+                                              ctx->ocf.hwctx->device_id,
+                                              0, &cle);
+    CL_FAIL_ON_ERROR(AVERROR(EIO), "Failed to create OpenCL "
+                     "command queue %d.\n", cle);
+
+    main_planes = overlay_planes = 0;
+    for (i = 0; i < main_desc->nb_components; i++)
+        main_planes = FFMAX(main_planes,
+                            main_desc->comp[i].plane + 1);
+    for (i = 0; i < overlay_desc->nb_components; i++)
+        overlay_planes = FFMAX(overlay_planes,
+                               overlay_desc->comp[i].plane + 1);
+
+    ctx->nb_planes = main_planes;
+    ctx->x_subsample = 1 << main_desc->log2_chroma_w;
+    ctx->y_subsample = 1 << main_desc->log2_chroma_h;
+
+    if (ctx->x % ctx->x_subsample ||
+        ctx->y % ctx->y_subsample) {
+        av_log(avctx, AV_LOG_WARNING, "Warning: overlay position (%d, %d) "
+               "does not match subsampling (%d, %d).\n",
+               ctx->x, ctx->y, ctx->x_subsample, ctx->y_subsample);
+    }
+
+    if (main_planes != overlay_planes ||
+        main_desc->nb_components == overlay_desc->nb_components) {
+        av_log(avctx, AV_LOG_ERROR, "Overlay %s format over %s is not supported (alfa channel conflict).\n",
+               overlay_desc->name, main_desc->name);
+        return AVERROR(EINVAL);
+    }
+
+    scalex = FFMAX((float) ctx->src_w / ctx->width, 1);
+    scaley = FFMAX((float) ctx->src_h / ctx->height, 1);
+    filterw = ceil(2 * LANCZOS_RADIUS * scalex);
+    filterh = ceil(2 * LANCZOS_RADIUS * scaley);
+
+    filterw = FFMIN(filterw, ctx->src_w - 2);
+    filterw = FFMAX(filterw, 1);
+    filterh = FFMIN(filterh, ctx->src_h - 2);
+    filterh = FFMAX(filterh, 1);
+
+    ctx->flt_size.s[0] = filterw;
+    ctx->flt_size.s[1] = filterh;
+
+    av_log(avctx, AV_LOG_INFO, "filter size: %d %d.\n", filterw, filterh);
+
+    cx = av_malloc_array(ctx->width * filterw, sizeof(cl_float));
+    cy = av_malloc_array(ctx->height * filterh, sizeof(cl_float));
+
+    if (!cx || !cy) {
+        err = AVERROR(ENOMEM);
+        goto fail;
+    }
+
+    for (i = 0; i < ctx->width; ++i) {
+        float s_x = (i + 0.5) * ctx->src_w / ctx->width - 0.5;
+        float t = s_x - floor(s_x);  // fract
+
+        float sum = 0;
+        for (j = 0; j < filterw; ++j) {
+            int x = filterw/2 - j;
+            sum += cx[i * filterw + j] = lanczos((x - t) / scalex, LANCZOS_RADIUS);
+        }
+
+        for (j = 0; j < filterw; ++j)
+            cx[i * filterw + j] /= sum;
+    }
+
+    for (i = 0; i < ctx->height; ++i) {
+        float s_y = (i + 0.5) * ctx->src_h / ctx->height - 0.5;
+        float t = s_y - floor(s_y);  // fract
+
+        float sum = 0;
+        for (j = 0; j < filterh; ++j) {
+            int y = filterh/2 - j;
+            sum += cy[i * filterh + j] = lanczos((y - t) / scaley, LANCZOS_RADIUS);
+        }
+
+        for (j = 0; j < filterh; ++j)
+            cy[i * filterh + j] /= sum;
+    }
+
+    ctx->cx = clCreateBuffer(ctx->ocf.hwctx->context,
+                                CL_MEM_READ_ONLY     |
+                                CL_MEM_COPY_HOST_PTR |
+                                CL_MEM_HOST_NO_ACCESS,
+                                ctx->width * filterw * sizeof(cl_float),
+                                cx,
+                                &cle);
+
+    ctx->cy = clCreateBuffer(ctx->ocf.hwctx->context,
+                                CL_MEM_READ_ONLY     |
+                                CL_MEM_COPY_HOST_PTR |
+                                CL_MEM_HOST_NO_ACCESS,
+                                ctx->height * filterh * sizeof(cl_float),
+                                cy,
+                                &cle);
+    av_free(cx);
+    av_free(cy);
+    if (!ctx->cx || !ctx->cy) {
+        av_log(avctx, AV_LOG_ERROR, "Failed to create weights buffer: %d.\n", cle);
+        err = AVERROR(EIO);
+        goto fail;
+    }
+
+    if (ctx->dir == NO_TRANSPOSE)
+        kernel = "overlay_no_transpose";
+    else
+        kernel = "overlay";
+
+    av_log(avctx, AV_LOG_DEBUG, "Using kernel %s.\n", kernel);
+    ctx->kernel = clCreateKernel(ctx->ocf.program, kernel, &cle);
+    CL_FAIL_ON_ERROR(AVERROR(EIO), "Failed to create kernel %d.\n", cle);
+
+    ctx->initialised = 1;
+    return 0;
+
+fail:
+    if (ctx->command_queue)
+        clReleaseCommandQueue(ctx->command_queue);
+    if (ctx->kernel)
+        clReleaseKernel(ctx->kernel);
+    if (ctx->cx)
+        clReleaseMemObject(ctx->cx);
+    if (ctx->cy)
+        clReleaseMemObject(ctx->cy);
+    if (cx)
+        av_free(cx);
+    if (cy)
+        av_free(cy);
+    return err;
+}
+
+static int sv_participant_opencl_blend(FFFrameSync *fs)
+{
+    AVFilterContext    *avctx = fs->parent;
+    AVFilterLink     *outlink = avctx->outputs[0];
+    SvParticipantOpenCLContext *ctx = avctx->priv;
+    AVFrame *input_main, *input_overlay;
+    AVFrame *output;
+    cl_mem mem;
+    cl_int cle;
+    cl_int2 overlay_loc, overlay_size;
+    size_t global_work[2];
+    int kernel_arg = 0;
+    int err, plane;
+
+    err = ff_framesync_get_frame(fs, 0, &input_main, 0);
+    if (err < 0)
+        return err;
+    err = ff_framesync_get_frame(fs, 1, &input_overlay, 0);
+    if (err < 0)
+        return err;
+
+    if (!input_main->hw_frames_ctx || !input_overlay->hw_frames_ctx)
+        return AVERROR(EINVAL);
+
+    if (!ctx->initialised) {
+        AVHWFramesContext *main_fc =
+            (AVHWFramesContext*)input_main->hw_frames_ctx->data;
+        AVHWFramesContext *overlay_fc =
+            (AVHWFramesContext*)input_overlay->hw_frames_ctx->data;
+
+        err = sv_participant_opencl_load(avctx, main_fc->sw_format,
+                                         overlay_fc->sw_format);
+        if (err < 0)
+            return err;
+    }
+
+    output = ff_get_video_buffer(outlink, outlink->w, outlink->h);
+    if (!output) {
+        err = AVERROR(ENOMEM);
+        goto fail;
+    }
+
+    for (plane = 0; plane < ctx->nb_planes; plane++) {
+        kernel_arg = 0;
+
+        mem = (cl_mem)output->data[plane];
+        CL_SET_KERNEL_ARG(ctx->kernel, kernel_arg, cl_mem, &mem);
+        kernel_arg++;
+
+        mem = (cl_mem)input_main->data[plane];
+        CL_SET_KERNEL_ARG(ctx->kernel, kernel_arg, cl_mem, &mem);
+        kernel_arg++;
+
+        mem = (cl_mem)input_overlay->data[plane];
+        CL_SET_KERNEL_ARG(ctx->kernel, kernel_arg, cl_mem, &mem);
+        kernel_arg++;
+
+        
+        overlay_loc.s[0] = ctx->x / (plane == 0 ? 1 : ctx->x_subsample);
+        overlay_loc.s[1] = ctx->y / (plane == 0 ? 1 : ctx->y_subsample);
+
+        CL_SET_KERNEL_ARG(ctx->kernel, kernel_arg, cl_int2, &overlay_loc);
+        kernel_arg++;
+
+        overlay_size.s[0] = ctx->width / (plane == 0 ? 1 : ctx->x_subsample);
+        overlay_size.s[1] = ctx->height / (plane == 0 ? 1 : ctx->y_subsample);
+
+        CL_SET_KERNEL_ARG(ctx->kernel, kernel_arg, cl_int2, &overlay_loc);
+        kernel_arg++;
+
+        CL_SET_KERNEL_ARG(ctx->kernel, kernel_arg, cl_float4, &ctx->bordercolor_rgba_float);
+        kernel_arg++;
+
+        if(ctx->dir != NO_TRANSPOSE) {
+            CL_SET_KERNEL_ARG(ctx->kernel, kernel_arg, cl_int, &ctx->dir);
+            kernel_arg++;
+        }
+
+        CL_SET_KERNEL_ARG(ctx->kernel, kernel_arg, cl_mem, &ctx->cx);
+        kernel_arg++;
+        CL_SET_KERNEL_ARG(ctx->kernel, kernel_arg, cl_mem, &ctx->cy);
+        kernel_arg++;
+        CL_SET_KERNEL_ARG(ctx->kernel, kernel_arg, cl_int2, &ctx->flt_size);
+        kernel_arg++;
+
+        err = ff_opencl_filter_work_size_from_image(avctx, global_work,
+                                                    output, plane, 0);
+        if (err < 0)
+            goto fail;
+
+        cle = clEnqueueNDRangeKernel(ctx->command_queue, ctx->kernel, 2, NULL,
+                                     global_work, NULL, 0, NULL, NULL);
+        CL_FAIL_ON_ERROR(AVERROR(EIO), "Failed to enqueue kernel "
+                         "for plane %d: %d.\n", plane, cle);
+    }
+
+    cle = clFinish(ctx->command_queue);
+    CL_FAIL_ON_ERROR(AVERROR(EIO), "Failed to finish command queue: %d.\n", cle);
+
+    err = av_frame_copy_props(output, input_main);
+
+    av_log(avctx, AV_LOG_DEBUG, "Filter output: %s, %ux%u (%"PRId64").\n",
+           av_get_pix_fmt_name(output->format),
+           output->width, output->height, output->pts);
+
+    return ff_filter_frame(outlink, output);
+
+fail:
+    av_frame_free(&output);
+    return err;
+}
+
+static int sv_participant_opencl_config_output(AVFilterLink *outlink)
+{
+    AVFilterContext *avctx = outlink->src;
+    SvParticipantOpenCLContext *ctx = avctx->priv;
+    AVFilterLink *inlink = avctx->inputs[1];
+    FilterLink      *inl  = ff_filter_link(inlink);
+    FilterLink      *outl = ff_filter_link(outlink);
+    const AVPixFmtDescriptor *desc_in  = av_pix_fmt_desc_get(inlink->format);
+    double var_values[VARS_NB], res;
+    int err, ret;
+    char *expr;
+
+    var_values[VAR_IN_W]  = var_values[VAR_IW] = inlink->w;
+    var_values[VAR_IN_H]  = var_values[VAR_IH] = inlink->h;
+    var_values[VAR_OUT_W] = var_values[VAR_OW] = NAN;
+    var_values[VAR_OUT_H] = var_values[VAR_OH] = NAN;
+    var_values[VAR_A]     = (double) inlink->w / inlink->h;
+    var_values[VAR_SAR]   = inlink->sample_aspect_ratio.num ?
+        (double) inlink->sample_aspect_ratio.num / inlink->sample_aspect_ratio.den : 1;
+    var_values[VAR_DAR]   = var_values[VAR_A] * var_values[VAR_SAR];
+
+    av_expr_parse_and_eval(&res, (expr = ctx->w_expr),
+                           var_names, var_values,
+                           NULL, NULL, NULL, NULL, NULL, 0, ctx);
+    ctx->width = var_values[VAR_OUT_W] = var_values[VAR_OW] = res;
+    if ((ret = av_expr_parse_and_eval(&res, (expr = ctx->h_expr),
+                                      var_names, var_values,
+                                      NULL, NULL, NULL, NULL, NULL, 0, ctx)) < 0)
+        return ret;
+    ctx->height = var_values[VAR_OUT_H] = var_values[VAR_OH] = res;
+    if (!ctx->height)
+        var_values[VAR_OUT_H] = var_values[VAR_OH] = ctx->height = inlink->h;
+
+    /* evaluate the width again, as it may depend on the evaluated output height */
+    if ((ret = av_expr_parse_and_eval(&res, (expr = ctx->w_expr),
+                                      var_names, var_values,
+                                      NULL, NULL, NULL, NULL, NULL, 0, ctx)) < 0)
+        return ret;
+    ctx->width = var_values[VAR_OUT_W] = var_values[VAR_OW] = res;
+    if (!ctx->width)
+        var_values[VAR_OUT_W] = var_values[VAR_OW] = ctx->width = inlink->w;
+
+    /* evaluate x and y */
+    av_expr_parse_and_eval(&res, (expr = ctx->x_expr),
+                           var_names, var_values,
+                           NULL, NULL, NULL, NULL, NULL, 0, ctx);
+    ctx->x = var_values[VAR_X] = res;
+    if ((ret = av_expr_parse_and_eval(&res, (expr = ctx->y_expr),
+                                      var_names, var_values,
+                                      NULL, NULL, NULL, NULL, NULL, 0, ctx)) < 0)
+        return ret;
+    ctx->y = var_values[VAR_Y] = res;
+    /* evaluate x again, as it may depend on the evaluated y value */
+    if ((ret = av_expr_parse_and_eval(&res, (expr = ctx->x_expr),
+                                      var_names, var_values,
+                                      NULL, NULL, NULL, NULL, NULL, 0, ctx)) < 0)
+        return ret;
+
+    ctx->src_w = inlink->w;
+    ctx->src_h = inlink->h;
+
+    if (((int64_t) ctx->height * inlink->w) > INT_MAX  ||
+        ((int64_t) ctx->width * inlink->h) > INT_MAX)
+        av_log(ctx, AV_LOG_ERROR, "Rescaled value for width or height is too big.\n");
+
+    if (desc_in->log2_chroma_w != desc_in->log2_chroma_h) {
+        av_log(avctx, AV_LOG_ERROR, "Input format %s for overlay is not supported.\n",
+               desc_in->name);
+        return AVERROR(EINVAL);
+    }
+
+    err = ff_opencl_filter_config_output(outlink);
+    if (err < 0)
+        return err;
+
+    err = ff_framesync_init_dualinput(&ctx->fs, avctx);
+    if (err < 0)
+        return err;
+
+    return ff_framesync_configure(&ctx->fs);
+}
+
+static av_cold int sv_participant_opencl_init(AVFilterContext *avctx)
+{
+    SvParticipantOpenCLContext *ctx = avctx->priv;
+
+    for (int i = 0; i < 4; ++i) {
+        ctx->bordercolor_rgba_float.s[i] = (float)ctx->bordercolor_rgba[i] / 255.0;
+    }
+
+    ctx->fs.on_event = &sv_participant_opencl_blend;
+
+    return ff_opencl_filter_init(avctx);
+}
+
+static int sv_participant_opencl_activate(AVFilterContext *avctx)
+{
+    SvParticipantOpenCLContext *ctx = avctx->priv;
+
+    return ff_framesync_activate(&ctx->fs);
+}
+
+static av_cold void sv_participant_opencl_uninit(AVFilterContext *avctx)
+{
+    SvParticipantOpenCLContext *ctx = avctx->priv;
+    cl_int cle;
+
+    if (ctx->kernel) {
+        cle = clReleaseKernel(ctx->kernel);
+        if (cle != CL_SUCCESS)
+            av_log(avctx, AV_LOG_ERROR, "Failed to release "
+                   "kernel: %d.\n", cle);
+    }
+
+    if (ctx->command_queue) {
+        cle = clReleaseCommandQueue(ctx->command_queue);
+        if (cle != CL_SUCCESS)
+            av_log(avctx, AV_LOG_ERROR, "Failed to release "
+                   "command queue: %d.\n", cle);
+    }
+
+    ff_opencl_filter_uninit(avctx);
+
+    ff_framesync_uninit(&ctx->fs);
+}

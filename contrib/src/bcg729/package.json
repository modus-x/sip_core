{
    "name": "bcg729",
    "version": "1.1.1",
    "url": "https://nexus.svetlocal.ru/repository/github-artifacts/bcg729-__VERSION__.tar.gz",
    "deps": [],
    "patches": [],
    "win_patches": [],
    "project_paths": ["msvc/ALL_BUILD.vcxproj"],
    "with_env" : "",
    "custom_scripts": {
        "pre_build": [
            "mkdir msvc & cd msvc & cmake .. -G %CMAKE_GENERATOR% -DENABLE_SHARED=NO -DENABLE_TESTS=NO -DENABLE_STATIC=YES"
        ],
        "build": [],
        "post_build": ["if not exist \"%INSTALL_PREFIX%\\include\\bcg729\" mkdir \"%INSTALL_PREFIX%\\include\\bcg729\" & cd include/bcg729 & xcopy /S /Y *.h \"%INSTALL_PREFIX%\\include\\bcg729\""]
    }
}